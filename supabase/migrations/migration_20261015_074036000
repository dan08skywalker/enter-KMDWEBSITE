do $$
declare
  v_def text;
  v_new text;
  v_matched int;
begin
  select pg_get_functiondef(p.oid) into v_def
    from pg_proc p
    join pg_namespace n on n.oid = p.pronamespace
   where n.nspname = 'public' and p.proname = 'kmd_admin_export';

  -- [^;] keeps each match inside a single statement, so one branch is never merged
  -- with the next.
  select count(*) into v_matched
    from regexp_matches(v_def, '\]\)\)\s*,\s*''\[\]''::jsonb\)\)([^;]*?)(order by [^;]+);', 'g');

  v_new := regexp_replace(
    v_def,
    '\]\)\)\s*,\s*''\[\]''::jsonb\)\)([^;]*?)(order by [^;]+);',
    ']) \2), ''[]''::jsonb))\1;',
    'g'
  );

  if v_matched <> 8 or v_new = v_def then
    raise exception 'EXPORT FIX | expected 8 export branches, matched % - nothing applied', v_matched;
  end if;

  execute v_new;

  raise notice 'EXPORT FIX | moved % sorts inside their aggregate', v_matched;
end $$;