-- ============================================================================
-- Member-category pricing (pricing only)
--
-- Separate from reward configuration on purpose: the reward engine derives every
-- point and loyalty credit from reward_configurations x order quantity and never
-- reads a charged price, so what a member pays cannot alter a reward.
-- ============================================================================

create table if not exists public.member_prices (
  id uuid primary key default gen_random_uuid(),
  product_id uuid not null references public.products(id) on delete cascade,
  sku text not null,
  category text not null
    check (category in ('trial','classic','gold','platinum','stockist')),
  price numeric(14,2) not null check (price >= 0),
  -- The published SRP the price was taken from, kept as the reference figure.
  srp numeric(14,2),
  updated_by uuid,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create unique index if not exists member_prices_product_category_key
  on public.member_prices (product_id, category);
create index if not exists member_prices_sku_idx on public.member_prices (sku);

create trigger kmd_member_prices_touch before update on public.member_prices
  for each row execute function public.kmd_touch_updated_at();

-- Readable by administrators only; members receive the prices that apply to them
-- through the guarded function below, never the raw matrix.
alter table public.member_prices enable row level security;
create policy member_prices_select_admin on public.member_prices
  for select to authenticated using (public.kmd_is_admin(auth.uid()));

grant select on public.member_prices to authenticated;

-- Pricing rules are versioned on their own, independently of reward rules.
insert into public.system_settings (key, value, description)
values ('member_pricing_version', '1'::jsonb,
  'Version of the member pricing matrix. Incremented on every price change and recorded on each order line.')
on conflict (key) do nothing;

-- ---------- the buyer's authoritative pricing category ----------
-- tourder: profiles.account_type = 'retailer' is the existing administrator-approved
-- reseller designation (the admin Retailers screen is the only way to grant it), and
-- it stands in for City/Municipal Stockist. A membership tier comes from the linked
-- package. Nothing here is taken from the client.
create or replace function public.kmd_member_price_category(p_member uuid)
returns text
language plpgsql stable security definer set search_path = public as $$
declare
  v_member public.profiles%rowtype;
  v_tier text;
begin
  if p_member is null then
    return null;
  end if;

  select * into v_member from public.profiles where id = p_member;
  if not found then
    return null;
  end if;

  -- Member pricing requires an active, approved account.
  if v_member.account_status is distinct from 'active' then
    return null;
  end if;

  -- An approved stockist/reseller designation outranks a membership tier.
  if v_member.account_type = 'retailer' then
    return 'stockist';
  end if;

  select mp.tier into v_tier
    from public.membership_packages mp
   where mp.id = v_member.package_id and mp.is_active;

  if v_tier in ('trial','classic','gold','platinum') then
    return v_tier;
  end if;

  return null;
end $$;

-- ---------- one product, one buyer, one price ----------
create or replace function public.kmd_price_snapshot(p_member uuid, p_product_id uuid)
returns jsonb
language plpgsql stable security definer set search_path = public as $$
declare
  v_category text := public.kmd_member_price_category(p_member);
  v_row public.member_prices%rowtype;
  v_selling numeric(14,2);
  v_regular numeric(14,2);
  v_version text;
begin
  select selling_price, regular_price into v_selling, v_regular
    from public.products where id = p_product_id;
  if not found then
    return null;
  end if;

  select coalesce((value #>> '{}'), '1') into v_version
    from public.system_settings where key = 'member_pricing_version';
  v_version := coalesce(v_version, '1');

  if v_category is not null then
    select * into v_row from public.member_prices
      where product_id = p_product_id and category = v_category;
  end if;

  if found and v_row.price is not null then
    return jsonb_build_object(
      'memberPricing', true,
      'category', v_category,
      'price', v_row.price,
      'srp', coalesce(v_row.srp, v_regular, v_selling),
      'listPrice', v_selling,
      'version', v_version);
  end if;

  -- No eligible category, or no configured row: the published price applies.
  return jsonb_build_object(
    'memberPricing', false,
    'category', v_category,
    'price', v_selling,
    'srp', coalesce(v_regular, v_selling),
    'listPrice', v_selling,
    'version', v_version);
end $$;

-- The price the server will charge this buyer for this product.
create or replace function public.kmd_effective_unit_price(p_member uuid, p_product_id uuid)
returns numeric
language sql stable security definer set search_path = public as $$
  select coalesce((public.kmd_price_snapshot(p_member, p_product_id)->>'price')::numeric, 0);
$$;

revoke all on function public.kmd_member_price_category(uuid) from public, anon, authenticated;
revoke all on function public.kmd_price_snapshot(uuid,uuid) from public, anon, authenticated;
revoke all on function public.kmd_effective_unit_price(uuid,uuid) from public, anon, authenticated;
grant execute on function public.kmd_member_price_category(uuid) to service_role;
grant execute on function public.kmd_price_snapshot(uuid,uuid) to service_role;
grant execute on function public.kmd_effective_unit_price(uuid,uuid) to service_role;