-- Isolated test: the receiving Level 1 sponsor holds a Classic package, whose cap is 380.
update public.profiles set package_id = (select id from public.membership_packages where package_code = 'KMD-PKG-CLASSIC')
 where is_test and username = 'testsponsor1';

select public.kmd_create_order((select id from public.products where sku = 'KMD-VIP-SIGNATURE'), 1,
  (select id from public.profiles where username = 'testbuyer')) as vip_order_for_a_classic_sponsor;