-- Correction: the member-area order keeps its original payment-method handling
-- (unset until the member actually pays). Only the pricing changes are intended.
create or replace function public.kmd_create_order(p_product_id uuid, p_quantity int, p_buyer uuid default null)
returns jsonb language plpgsql security definer set search_path = public as $$
declare
  v_buyer_id uuid;
  v_buyer public.profiles%rowtype;
  v_product public.products%rowtype;
  v_order_id uuid;
  v_order_number text;
  v_pricing jsonb;
  v_line_price numeric(14,2);
begin
  v_buyer_id := coalesce(p_buyer, auth.uid());
  if v_buyer_id is null then
    raise exception 'KMD_UNAUTHENTICATED: you must be signed in to place an order';
  end if;
  if p_quantity is null or p_quantity < 1 then
    raise exception 'KMD_VALIDATION: quantity must be at least 1';
  end if;

  select * into v_buyer from public.profiles where id = v_buyer_id;
  if not found then
    raise exception 'KMD_BUYER_MEMBER_RECORD_NOT_FOUND: member record not found';
  end if;

  select * into v_product from public.products where id = p_product_id;
  if not found then
    raise exception 'KMD_PRODUCT_NOT_FOUND: product ID % does not exist', p_product_id;
  end if;
  if not v_product.is_active then
    raise exception 'KMD_PRODUCT_INACTIVE: % is not available', v_product.name;
  end if;

  v_pricing := public.kmd_price_snapshot(v_buyer_id, v_product.id);
  v_line_price := coalesce((v_pricing->>'price')::numeric, v_product.selling_price);

  v_order_number := 'KMD-ORDER-' || lpad(nextval('public.kmd_order_seq')::text, 6, '0');

  insert into public.orders (
    order_number, buyer_profile_id, buyer_member_code, customer_type,
    total_amount, subtotal, shipping_fee, is_shipping_quoted,
    status, fulfillment_status, is_test
  ) values (
    v_order_number, v_buyer.id, v_buyer.member_code, 'member',
    v_line_price * p_quantity, v_line_price * p_quantity, 0, true,
    'pending_payment', 'unfulfilled', v_buyer.is_test
  ) returning id into v_order_id;

  insert into public.order_items (
    order_id, product_id, sku, product_name, quantity, unit_price, line_total,
    pricing_category, pricing_rule_version, currency
  ) values (
    v_order_id, v_product.id, v_product.sku, v_product.name, p_quantity, v_line_price,
    v_line_price * p_quantity,
    case when coalesce((v_pricing->>'memberPricing')::boolean, false) then v_pricing->>'category' end,
    v_pricing->>'version', 'PHP');

  return jsonb_build_object(
    'orderId', v_order_id,
    'orderNumber', v_order_number,
    'status', 'pending_payment',
    'sku', v_product.sku,
    'productName', v_product.name,
    'quantity', p_quantity,
    'unitPrice', v_line_price,
    'pricingCategory', case when coalesce((v_pricing->>'memberPricing')::boolean, false) then v_pricing->>'category' end,
    'totalAmount', v_line_price * p_quantity
  );
end $$;

revoke all on function public.kmd_create_order(uuid,int,uuid) from public, anon;
grant execute on function public.kmd_create_order(uuid,int,uuid) to authenticated, service_role;