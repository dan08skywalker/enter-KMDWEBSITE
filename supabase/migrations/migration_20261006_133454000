-- ---------- Reward Engine Diagnostics (required, section 26) ----------
create or replace function public.kmd_diagnose_order(p_identifier text)
returns jsonb
language plpgsql stable security definer set search_path = public as $$
declare
  v_order public.orders%rowtype;
  v_buyer public.profiles%rowtype;
  v_checks jsonb := '[]'::jsonb;
  v_item record;
  v_ancestor uuid;
  v_ben public.profiles%rowtype;
  v_level int;
  v_cfg record;
  v_product_issues int := 0;
  v_sku_issues int := 0;
  v_buyer_ok boolean := false;
  v_expected numeric := 0;
  v_actual_ledger int := 0;
  v_loyalty_rows int := 0;
  v_loyalty_configured numeric := 0;
  v_config_missing jsonb := '[]'::jsonb;
  v_ppu numeric;
  v_levels jsonb := '[]'::jsonb;
  v_sync_issues jsonb := '[]'::jsonb;
  v_sync_ok boolean := true;
  v_bal jsonb;
  v_ben_list uuid[];
  v_b uuid;
  v_cached numeric;
begin
  select * into v_order from public.orders o
   where o.id::text = trim(p_identifier) or upper(o.order_number) = upper(trim(p_identifier))
   limit 1;

  if not found then
    return jsonb_build_object(
      'found', false,
      'identifier', p_identifier,
      'message', 'PURCHASE DB RECORD NOT FOUND for ' || p_identifier,
      'checks', jsonb_build_array(
        jsonb_build_object('key','purchase_record','label','Purchase DB Record','passed',false,
          'reasonText','PURCHASE DB RECORD NOT FOUND for ' || p_identifier)));
  end if;

  -- product / sku integrity across line items
  select count(*) into v_product_issues from public.order_items oi
    where oi.order_id = v_order.id and not exists (select 1 from public.products p where p.id = oi.product_id);

  select count(*) into v_sku_issues from public.order_items oi
    join public.products p on p.id = oi.product_id
    where oi.order_id = v_order.id and p.sku <> oi.sku;

  select * into v_buyer from public.profiles where id = v_order.buyer_profile_id;
  v_buyer_ok := found and v_buyer.member_code = v_order.buyer_member_code;

  -- genealogy + expected points
  for v_level in 1..5 loop
    select sr.ancestor_id into v_ancestor from public.sponsor_relationships sr
      where sr.descendant_id = v_order.buyer_profile_id and sr.level = v_level;

    if v_ancestor is null then
      v_levels := v_levels || jsonb_build_object('key','sponsor_level_'||v_level,'label','Sponsor Level '||v_level||' Match',
        'passed',false,'reasonText','LEVEL ' || v_level || ' UPLINE DOES NOT EXIST');
      continue;
    end if;

    select * into v_ben from public.profiles where id = v_ancestor;
    if not found then
      v_levels := v_levels || jsonb_build_object('key','sponsor_level_'||v_level,'label','Sponsor Level '||v_level||' Match',
        'passed',false,'reasonText','SPONSOR ID INVALID at level ' || v_level);
      continue;
    end if;

    if v_ben.account_status <> 'active' then
      v_levels := v_levels || jsonb_build_object('key','sponsor_level_'||v_level,'label','Sponsor Level '||v_level||' Match',
        'passed',false,'memberCode',v_ben.member_code,
        'reasonText','LEVEL ' || v_level || ' UPLINE ' || v_ben.member_code || ' IS NOT ACTIVE');
      continue;
    end if;

    v_levels := v_levels || jsonb_build_object('key','sponsor_level_'||v_level,'label','Sponsor Level '||v_level||' Match',
      'passed',true,'memberCode',v_ben.member_code,'memberName',v_ben.full_name);
  end loop;

  -- expected points from the configuration matrix
  for v_item in
    select oi.id as item_id, oi.product_id, oi.sku, oi.quantity from public.order_items oi where oi.order_id = v_order.id
  loop
    select * into v_cfg from public.reward_configurations rc
      where rc.product_id = v_item.product_id and rc.is_active = true;

    if not found then
      v_config_missing := v_config_missing || jsonb_build_object('sku', v_item.sku,
        'reasonText','PRODUCT SKU HAS NO REWARD CONFIGURATION (SKU ' || coalesce(v_item.sku,'?') || ')');
      continue;
    end if;

    v_loyalty_configured := v_loyalty_configured + coalesce(v_cfg.loyalty_credit,0);

    for v_level in 1..5 loop
      select sr.ancestor_id into v_ancestor from public.sponsor_relationships sr
        where sr.descendant_id = v_order.buyer_profile_id and sr.level = v_level;
      if v_ancestor is null then continue; end if;

      select * into v_ben from public.profiles where id = v_ancestor;
      if not found or v_ben.account_status <> 'active' then continue; end if;

      v_ppu := case v_level
        when 1 then v_cfg.level1_points when 2 then v_cfg.level2_points
        when 3 then v_cfg.level3_points when 4 then v_cfg.level4_points
        when 5 then v_cfg.level5_points end;

      if coalesce(v_ppu,0) > 0 then
        v_expected := v_expected + (v_ppu * v_item.quantity);
      end if;
    end loop;
  end loop;

  select count(*) into v_actual_ledger from public.point_ledger where order_id = v_order.id;
  select count(*) into v_loyalty_rows from public.loyalty_credit_ledger where order_id = v_order.id;

  -- dashboard sync: cached balances must equal the ledger for every beneficiary of this order
  select array_agg(distinct beneficiary_id) into v_ben_list from public.point_ledger where order_id = v_order.id;
  if v_ben_list is not null then
    foreach v_b in array v_ben_list loop
      v_bal := public.kmd_member_balances(v_b);
      select p.unilevel_points_balance into v_cached from public.profiles p where p.id = v_b;
      if coalesce(v_cached,0) <> coalesce((v_bal->>'unilevelPoints')::numeric, 0) then
        v_sync_ok := false;
        v_sync_issues := v_sync_issues || jsonb_build_object('memberId', v_b,
          'reasonText','DISPLAYED BALANCE ' || coalesce(v_cached,0) || ' DOES NOT MATCH LEDGER ' || coalesce(v_bal->>'unilevelPoints','0'));
      end if;
    end loop;
  end if;

  v_checks := jsonb_build_array(
    jsonb_build_object('key','purchase_record','label','Purchase DB Record','passed',true,
      'reasonText','Order ' || v_order.order_number || ' found'),
    jsonb_build_object('key','payment_confirmation','label','Payment Confirmation','passed', v_order.status = 'confirmed',
      'reasonText', case when v_order.status = 'confirmed' then 'Payment confirmed' else 'PAYMENT NOT CONFIRMED (status: ' || v_order.status || ')' end),
    jsonb_build_object('key','product_id_match','label','Product ID Match','passed', v_product_issues = 0,
      'reasonText', case when v_product_issues = 0 then 'All line items resolve to a product ID' else 'PRODUCT RECORD NOT FOUND for ' || v_product_issues || ' line item(s)' end),
    jsonb_build_object('key','sku_match','label','SKU Match','passed', v_sku_issues = 0,
      'reasonText', case when v_sku_issues = 0 then 'Order SKU matches the product SKU' else 'SKU MISMATCH on ' || v_sku_issues || ' line item(s)' end),
    jsonb_build_object('key','buyer_member_match','label','Buyer Member Match','passed', v_buyer_ok,
      'reasonText', case when v_buyer_ok then 'Buyer resolves to ' || v_buyer.member_code else 'BUYER MEMBER RECORD NOT FOUND' end)
  );

  v_checks := v_checks || v_levels;

  v_checks := v_checks || jsonb_build_array(
    jsonb_build_object('key','points_calculation','label','Points Calculation',
      'passed', jsonb_array_length(v_config_missing) = 0,
      'expectedTotal', v_expected,
      'reasonText', case when jsonb_array_length(v_config_missing) = 0
        then 'Expected ' || v_expected || ' points from the configured matrix'
        else 'PRODUCT SKU HAS NO REWARD CONFIGURATION' end,
      'issues', v_config_missing),
    jsonb_build_object('key','point_ledger_record','label','Point Ledger Record',
      'passed', (v_actual_ledger > 0 or (v_expected = 0 and v_order.rewards_processed)),
      'reasonText', case
        when v_actual_ledger > 0 then v_actual_ledger || ' point ledger row(s) exist'
        when v_order.rewards_processed then 'No row required: every eligible level is configured at 0'
        else 'NO POINT LEDGER RECORD for this order' end),
    jsonb_build_object('key','loyalty_ledger_record','label','Loyalty Ledger Record',
      'passed', (v_loyalty_rows > 0 or v_loyalty_configured = 0),
      'reasonText', case
        when v_loyalty_rows > 0 then v_loyalty_rows || ' loyalty ledger row(s) exist'
        when v_loyalty_configured = 0 then 'No Loyalty Credit configured for this product - no row required'
        else 'LOYALTY CREDIT IS CONFIGURED BUT NO LOYALTY LEDGER RECORD EXISTS' end),
    jsonb_build_object('key','backend_response','label','Backend Response',
      'passed', v_order.rewards_processed,
      'reasonText', case
        when v_order.rewards_processed then 'Reward engine completed at ' || coalesce(v_order.rewards_processed_at::text,'') 
        when v_order.status = 'confirmed' then 'REWARD PROCESSING HAS NOT RUN YET - confirm payment to trigger it'
        else 'PAYMENT NOT CONFIRMED' end),
    jsonb_build_object('key','dashboard_sync','label','Dashboard Sync','passed', v_sync_ok,
      'reasonText', case when v_sync_ok then 'Displayed balances match the ledger'
        else 'DISPLAYED BALANCE DOES NOT MATCH THE LEDGER' end,
      'issues', v_sync_issues)
  );

  return jsonb_build_object(
    'found', true,
    'identifier', p_identifier,
    'orderId', v_order.id,
    'orderNumber', v_order.order_number,
    'orderStatus', v_order.status,
    'buyerMemberCode', v_order.buyer_member_code,
    'rewardsProcessed', v_order.rewards_processed,
    'rewardsProcessedAt', v_order.rewards_processed_at,
    'expectedPoints', v_expected,
    'ledgerRows', v_actual_ledger,
    'loyaltyRows', v_loyalty_rows,
    'checks', v_checks);
end $$;

-- ---------- Redemption request (sections 20-21) ----------
create or replace function public.kmd_request_redemption(
  p_member uuid,
  p_points numeric,
  p_redemption_type text,
  p_gcash_number text default null,
  p_gcash_account_name text default null,
  p_bank_name text default null,
  p_bank_account_name text default null,
  p_bank_account_number text default null,
  p_other_bank_name text default null,
  p_actor uuid default null
) returns jsonb
language plpgsql security definer set search_path = public as $$
declare
  v_member public.profiles%rowtype;
  v_bal jsonb;
  v_available numeric;
  v_rate numeric := 1;
  v_id uuid;
  v_number text;
  v_key text;
  v_txn text;
  v_ledger uuid;
begin
  select * into v_member from public.profiles where id = p_member;
  if not found then
    return jsonb_build_object('status','REJECTED','reason','MEMBER_NOT_FOUND','reasonText','Member record not found');
  end if;

  if p_redemption_type not in ('PAYOUT_GCASH','PAYOUT_BANK','SHOPPING_WALLET') then
    return jsonb_build_object('status','REJECTED','reason','INVALID_REDEMPTION_TYPE',
      'reasonText','Unsupported redemption type: ' || coalesce(p_redemption_type,'(none)'));
  end if;

  if p_points is null or p_points <= 0 then
    return jsonb_build_object('status','REJECTED','reason','INVALID_POINT_AMOUNT',
      'reasonText','Requested points must be greater than zero');
  end if;

  if p_redemption_type = 'PAYOUT_GCASH' and (p_gcash_number is null or length(trim(p_gcash_number)) = 0) then
    return jsonb_build_object('status','REJECTED','reason','GCASH_NUMBER_REQUIRED','reasonText','GCash number is required');
  end if;
  if p_redemption_type = 'PAYOUT_BANK' and (coalesce(trim(p_bank_name),'') = '' or coalesce(trim(p_bank_account_number),'') = '') then
    return jsonb_build_object('status','REJECTED','reason','BANK_DETAILS_REQUIRED',
      'reasonText','Bank name and account number are required');
  end if;
  if p_redemption_type = 'PAYOUT_BANK' and upper(trim(coalesce(p_bank_name,''))) = 'OTHER BANK'
     and coalesce(trim(p_other_bank_name),'') = '' then
    return jsonb_build_object('status','REJECTED','reason','OTHER_BANK_NAME_REQUIRED','reasonText','Specify the bank name');
  end if;

  v_bal := public.kmd_member_balances(p_member);
  v_available := coalesce((v_bal->>'availablePoints')::numeric, 0);

  -- required test #7: a request may never exceed the available balance
  if p_points > v_available then
    return jsonb_build_object(
      'status','REJECTED',
      'reason','INSUFFICIENT_AVAILABLE_POINTS',
      'reasonText','REJECTED - INSUFFICIENT AVAILABLE POINTS',
      'availablePoints', v_available,
      'requestedPoints', p_points);
  end if;

  select coalesce((value #>> '{}')::numeric, 1) into v_rate from public.system_settings where key = 'point_to_peso_rate';
  v_rate := coalesce(v_rate, 1);

  v_number := 'KMD-RDM-' || lpad(nextval('public.kmd_redemption_seq')::text, 6, '0');
  v_key := 'redemption:' || v_number;
  v_txn := 'KMD-PT-' || lpad(nextval('public.kmd_point_txn_seq')::text, 8, '0');

  insert into public.redemptions (
    redemption_number, member_id, member_code, redemption_type, points, peso_value, status,
    gcash_number, gcash_account_name, bank_name, bank_account_name, bank_account_number,
    other_bank_name, is_test
  ) values (
    v_number, p_member, v_member.member_code, p_redemption_type, p_points, p_points * v_rate, 'pending',
    nullif(trim(coalesce(p_gcash_number,'')),''), nullif(trim(coalesce(p_gcash_account_name,'')),''),
    nullif(trim(coalesce(p_bank_name,'')),''), nullif(trim(coalesce(p_bank_account_name,'')),''),
    nullif(trim(coalesce(p_bank_account_number,'')),''), nullif(trim(coalesce(p_other_bank_name,'')),''),
    v_member.is_test
  ) returning id into v_id;

  -- held debit: reduces available points immediately, excluded from posted balance
  insert into public.point_ledger (
    transaction_id, beneficiary_id, beneficiary_member_code, total_points,
    reward_type, transaction_type, direction, status, trigger_event, idempotency_key, note, is_test
  ) values (
    v_txn, p_member, v_member.member_code, p_points,
    'REDEMPTION','REDEMPTION','DEBIT','pending','redemption_request', v_key,
    'Redemption ' || v_number || ' awaiting approval', v_member.is_test
  ) returning id into v_ledger;

  update public.redemptions set point_ledger_id = v_ledger where id = v_id;

  perform public.kmd_audit(p_actor, 'REDEMPTION_REQUEST', p_member, null, 'redemptions', v_id::text,
    null, jsonb_build_object('redemptionNumber', v_number, 'points', p_points, 'type', p_redemption_type),
    'Member redemption request', v_member.is_test);

  return jsonb_build_object(
    'status','PENDING',
    'redemptionId', v_id,
    'redemptionNumber', v_number,
    'points', p_points,
    'pesoValue', p_points * v_rate,
    'availablePoints', v_available,
    'reasonText','Redemption request submitted for approval');
end $$;

-- ---------- Redemption approval / rejection ----------
create or replace function public.kmd_review_redemption(
  p_redemption_id uuid,
  p_actor uuid,
  p_action text,
  p_reason text default null
) returns jsonb
language plpgsql security definer set search_path = public as $$
declare
  v_red public.redemptions%rowtype;
  v_member public.profiles%rowtype;
begin
  select * into v_red from public.redemptions where id = p_redemption_id for update;
  if not found then
    return jsonb_build_object('status','FAILED','reason','REDEMPTION_NOT_FOUND','reasonText','Redemption not found');
  end if;

  select * into v_member from public.profiles where id = v_red.member_id;

  if p_action = 'approve' then
    if v_red.status <> 'pending' then
      return jsonb_build_object('status','FAILED','reason','REDEMPTION_ALREADY_REVIEWED',
        'reasonText','This redemption is already ' || v_red.status);
    end if;
    update public.point_ledger set status = 'posted', posted_at = now(), processed_by = p_actor
      where id = v_red.point_ledger_id;
    update public.profiles
      set unilevel_points_balance = unilevel_points_balance - v_red.points
      where id = v_red.member_id;
    update public.redemptions set status = 'approved', reviewed_by = p_actor, reviewed_at = now()
      where id = p_redemption_id;

    perform public.kmd_audit(p_actor, 'REDEMPTION_APPROVAL', v_red.member_id, null, 'redemptions', p_redemption_id::text,
      jsonb_build_object('status','pending'), jsonb_build_object('status','approved','points', v_red.points),
      coalesce(p_reason, 'Redemption approved'), v_red.is_test);

    return jsonb_build_object('status','APPROVED','redemptionNumber', v_red.redemption_number,
      'points', v_red.points, 'memberCode', v_member.member_code, 'reasonText','Redemption approved');
  end if;

  if p_action = 'reject' then
    if v_red.status <> 'pending' then
      return jsonb_build_object('status','FAILED','reason','REDEMPTION_ALREADY_REVIEWED',
        'reasonText','This redemption is already ' || v_red.status);
    end if;
    update public.point_ledger set status = 'reversed', processed_by = p_actor, note = coalesce(p_reason, note)
      where id = v_red.point_ledger_id;
    update public.redemptions set status = 'rejected', reviewed_by = p_actor, reviewed_at = now(),
      rejection_reason = p_reason where id = p_redemption_id;

    perform public.kmd_audit(p_actor, 'REDEMPTION_REJECTION', v_red.member_id, null, 'redemptions', p_redemption_id::text,
      jsonb_build_object('status','pending'), jsonb_build_object('status','rejected'),
      coalesce(p_reason, 'Redemption rejected'), v_red.is_test);

    return jsonb_build_object('status','REJECTED','redemptionNumber', v_red.redemption_number,
      'points', v_red.points, 'reasonText','Redemption rejected and points released');
  end if;

  if p_action = 'paid' then
    if v_red.status <> 'approved' then
      return jsonb_build_object('status','FAILED','reason','REDEMPTION_NOT_APPROVED',
        'reasonText','Only an approved redemption can be marked paid');
    end if;
    update public.redemptions set status = 'paid' where id = p_redemption_id;
    perform public.kmd_audit(p_actor, 'REDEMPTION_PAID', v_red.member_id, null, 'redemptions', p_redemption_id::text,
      jsonb_build_object('status','approved'), jsonb_build_object('status','paid'),
      coalesce(p_reason, 'Payout released'), v_red.is_test);
    return jsonb_build_object('status','PAID','redemptionNumber', v_red.redemption_number,
      'reasonText','Redemption marked as paid');
  end if;

  return jsonb_build_object('status','FAILED','reason','UNKNOWN_ACTION',
    'reasonText','Unsupported redemption action: ' || coalesce(p_action,'(none)'));
end $$;

-- ---------- Points -> Shopping Wallet (section 22) ----------
create or replace function public.kmd_convert_to_wallet(
  p_member uuid,
  p_points numeric,
  p_actor uuid default null
) returns jsonb
language plpgsql security definer set search_path = public as $$
declare
  v_member public.profiles%rowtype;
  v_bal jsonb;
  v_available numeric;
  v_key text;
  v_txn text;
  v_wtxn text;
  v_pt_id uuid;
begin
  select * into v_member from public.profiles where id = p_member;
  if not found then
    return jsonb_build_object('status','REJECTED','reason','MEMBER_NOT_FOUND','reasonText','Member record not found');
  end if;
  if p_points is null or p_points <= 0 then
    return jsonb_build_object('status','REJECTED','reason','INVALID_POINT_AMOUNT',
      'reasonText','Points to convert must be greater than zero');
  end if;

  v_bal := public.kmd_member_balances(p_member);
  v_available := coalesce((v_bal->>'availablePoints')::numeric, 0);
  if p_points > v_available then
    return jsonb_build_object('status','REJECTED','reason','INSUFFICIENT_AVAILABLE_POINTS',
      'reasonText','REJECTED - INSUFFICIENT AVAILABLE POINTS',
      'availablePoints', v_available, 'requestedPoints', p_points);
  end if;

  v_key := 'wallet_conversion:' || p_member::text || ':' || extract(epoch from clock_timestamp())::text || ':' || p_points::text;
  v_txn := 'KMD-PT-' || lpad(nextval('public.kmd_point_txn_seq')::text, 8, '0');
  v_wtxn := 'KMD-WL-' || lpad(nextval('public.kmd_wallet_txn_seq')::text, 8, '0');

  insert into public.point_ledger (
    transaction_id, beneficiary_id, beneficiary_member_code, total_points,
    reward_type, transaction_type, direction, status, trigger_event, posted_at,
    processed_by, idempotency_key, note, is_test
  ) values (
    v_txn, p_member, v_member.member_code, p_points,
    'SHOPPING_WALLET_CONVERSION','SHOPPING_WALLET_CONVERSION','DEBIT','posted','wallet_conversion', now(),
    p_actor, v_key, 'Points converted to Shopping Wallet', v_member.is_test
  ) returning id into v_pt_id;

  insert into public.shopping_wallet_ledger (
    transaction_id, member_id, member_code, direction, amount, status, source_point_ledger_id,
    trigger_event, posted_at, processed_by, idempotency_key, note, is_test
  ) values (
    v_wtxn, p_member, v_member.member_code, 'CREDIT', p_points, 'posted', v_pt_id,
    'wallet_conversion', now(), p_actor, v_key || ':wallet', 'Shopping Wallet credit from point conversion', v_member.is_test
  );

  update public.profiles
    set unilevel_points_balance = unilevel_points_balance - p_points,
        shopping_wallet_balance = shopping_wallet_balance + p_points
    where id = p_member;

  perform public.kmd_audit(p_actor, 'POINT_TO_WALLET_CONVERSION', p_member, null, 'shopping_wallet_ledger', v_pt_id::text,
    jsonb_build_object('points', 0), jsonb_build_object('points', p_points), 'Points converted to Shopping Wallet', v_member.is_test);

  return jsonb_build_object('status','CONVERTED','points', p_points,
    'walletBalance', coalesce((v_bal->>'shoppingWallet')::numeric,0) + p_points,
    'availablePoints', v_available - p_points,
    'reasonText','Points converted to Shopping Wallet');
end $$;

-- ---------- Balance reconciliation (section 29) ----------
create or replace function public.kmd_reconcile_member_balance(p_member uuid)
returns jsonb
language plpgsql stable security definer set search_path = public as $$
declare
  v_member public.profiles%rowtype;
  v_bal jsonb;
  v_issues jsonb := '[]'::jsonb;
begin
  select * into v_member from public.profiles where id = p_member;
  if not found then
    return jsonb_build_object('status','FAILED','reasonText','Member record not found');
  end if;

  v_bal := public.kmd_member_balances(p_member);

  if v_member.unilevel_points_balance <> (v_bal->>'unilevelPoints')::numeric then
    v_issues := v_issues || jsonb_build_object('field','unilevel_points_balance',
      'displayed', v_member.unilevel_points_balance, 'ledger', (v_bal->>'unilevelPoints')::numeric);
  end if;
  if v_member.loyalty_credits_balance <> (v_bal->>'loyaltyCredits')::numeric then
    v_issues := v_issues || jsonb_build_object('field','loyalty_credits_balance',
      'displayed', v_member.loyalty_credits_balance, 'ledger', (v_bal->>'loyaltyCredits')::numeric);
  end if;
  if v_member.shopping_wallet_balance <> (v_bal->>'shoppingWallet')::numeric then
    v_issues := v_issues || jsonb_build_object('field','shopping_wallet_balance',
      'displayed', v_member.shopping_wallet_balance, 'ledger', (v_bal->>'shoppingWallet')::numeric);
  end if;

  return jsonb_build_object(
    'memberCode', v_member.member_code,
    'memberName', v_member.full_name,
    'consistent', jsonb_array_length(v_issues) = 0,
    'displayed', jsonb_build_object(
      'unilevelPoints', v_member.unilevel_points_balance,
      'loyaltyCredits', v_member.loyalty_credits_balance,
      'shoppingWallet', v_member.shopping_wallet_balance),
    'ledger', v_bal,
    'discrepancies', v_issues);
end $$;

-- ---------- Membership activation ----------
create or replace function public.kmd_activate_member(
  p_member uuid,
  p_actor uuid,
  p_package_id uuid default null,
  p_reason text default null
) returns jsonb
language plpgsql security definer set search_path = public as $$
declare
  v_member public.profiles%rowtype;
begin
  select * into v_member from public.profiles where id = p_member for update;
  if not found then
    return jsonb_build_object('status','FAILED','reason','MEMBER_NOT_FOUND','reasonText','Member record not found');
  end if;

  update public.profiles
    set account_status = 'active',
        activation_date = coalesce(activation_date, now()),
        package_id = coalesce(p_package_id, package_id)
    where id = p_member;

  perform public.kmd_audit(p_actor, 'MEMBERSHIP_ACTIVATION', p_member, null, 'profiles', p_member::text,
    jsonb_build_object('accountStatus', v_member.account_status, 'packageId', v_member.package_id),
    jsonb_build_object('accountStatus', 'active', 'packageId', coalesce(p_package_id, v_member.package_id)),
    coalesce(p_reason, 'Membership activated'), v_member.is_test);

  return jsonb_build_object('status','ACTIVATED','memberCode', v_member.member_code,
    'reasonText','Membership activated');
end $$;

-- ---------- Reward reversal (never edits history) ----------
create or replace function public.kmd_reverse_reward(
  p_ledger_id uuid,
  p_actor uuid,
  p_reason text default null
) returns jsonb
language plpgsql security definer set search_path = public as $$
declare
  v_row public.point_ledger%rowtype;
  v_key text;
  v_txn text;
  v_existing int;
begin
  select * into v_row from public.point_ledger where id = p_ledger_id;
  if not found then
    return jsonb_build_object('status','FAILED','reason','LEDGER_ROW_NOT_FOUND','reasonText','Point ledger row not found');
  end if;

  v_key := 'reversal:' || p_ledger_id::text;
  select count(*) into v_existing from public.point_ledger where idempotency_key = v_key;
  if v_existing > 0 then
    return jsonb_build_object('status','ALREADY_REVERSED','reason','REWARD_ALREADY_PROCESSED',
      'reasonText','REWARD ALREADY PROCESSED FOR THIS TRANSACTION','transactionId', v_row.transaction_id);
  end if;

  v_txn := 'KMD-PT-' || lpad(nextval('public.kmd_point_txn_seq')::text, 8, '0');

  -- history stays intact: the offset is a new immutable row
  insert into public.point_ledger (
    transaction_id, order_id, order_item_id, buyer_profile_id, buyer_member_code,
    beneficiary_id, beneficiary_member_code, product_id, sku, product_name, quantity,
    unilevel_level, points_per_unit, total_points,
    reward_type, transaction_type, direction, status, trigger_event, posted_at,
    processed_by, idempotency_key, note, is_test
  ) values (
    v_txn, v_row.order_id, v_row.order_item_id, v_row.buyer_profile_id, v_row.buyer_member_code,
    v_row.beneficiary_id, v_row.beneficiary_member_code, v_row.product_id, v_row.sku, v_row.product_name,
    v_row.quantity, v_row.unilevel_level, v_row.points_per_unit, v_row.total_points,
    'REVERSAL','REVERSAL','DEBIT','posted','reward_reversal', now(),
    p_actor, v_key, coalesce(p_reason,'Reversal of ' || v_row.transaction_id), v_row.is_test
  );

  update public.profiles
    set unilevel_points_balance = unilevel_points_balance - v_row.total_points,
        total_lifetime_earnings = greatest(total_lifetime_earnings - v_row.total_points, 0)
    where id = v_row.beneficiary_id;

  perform public.kmd_audit(p_actor, 'REWARD_REVERSAL', v_row.beneficiary_id, v_row.order_id,
    'point_ledger', p_ledger_id::text, jsonb_build_object('transactionId', v_row.transaction_id),
    jsonb_build_object('reversalTransactionId', v_txn, 'points', v_row.total_points),
    coalesce(p_reason, 'Reward reversed'), v_row.is_test);

  return jsonb_build_object('status','REVERSED','reversalTransactionId', v_txn,
    'points', v_row.total_points, 'reasonText','Reward reversed');
end $$;

-- ---------- Role management ----------
create or replace function public.kmd_set_member_role(p_user_id uuid, p_role text, p_actor uuid)
returns jsonb
language plpgsql security definer set search_path = public as $$
declare
  v_member public.profiles%rowtype;
begin
  if p_role not in ('member','retailer','admin','super_admin') then
    return jsonb_build_object('status','FAILED','reason','INVALID_ROLE','reasonText','Unsupported role: ' || coalesce(p_role,'(none)'));
  end if;

  select * into v_member from public.profiles where id = p_user_id;
  if not found then
    return jsonb_build_object('status','FAILED','reason','MEMBER_NOT_FOUND','reasonText','Member record not found');
  end if;

  insert into public.user_roles (user_id, role) values (p_user_id, p_role)
  on conflict (user_id, role) do nothing;

  perform public.kmd_audit(p_actor, 'ROLE_GRANTED', p_user_id, null, 'user_roles', p_user_id::text,
    null, jsonb_build_object('role', p_role), 'Role granted', v_member.is_test);

  return jsonb_build_object('status','GRANTED','role', p_role, 'memberCode', v_member.member_code,
    'reasonText','Role ' || p_role || ' granted');
end $$;

create or replace function public.kmd_has_super_admin()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from public.user_roles where role = 'super_admin');
$$;

