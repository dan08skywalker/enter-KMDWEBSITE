-- ============================================================
-- KMD EMPIRE · migration 1 · identity, roles, sponsor genealogy
-- First-time create. public schema verified empty before this migration.
-- ============================================================

create sequence if not exists public.kmd_member_code_seq start with 1 increment by 1;

-- ---------- roles --------------------------------------------
create table if not exists public.user_roles (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  role text not null check (role in ('member','retailer','admin','super_admin')),
  created_at timestamptz not null default now(),
  unique (user_id, role)
);

create index if not exists user_roles_user_idx on public.user_roles (user_id);

create or replace function public.has_role(p_user_id uuid, p_role text)
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from public.user_roles ur where ur.user_id = p_user_id and ur.role = p_role);
$$;

create or replace function public.kmd_is_admin(p_user_id uuid)
returns boolean language sql stable security definer set search_path = public as $$
  select exists (
    select 1 from public.user_roles ur
    where ur.user_id = p_user_id and ur.role in ('admin','super_admin')
  );
$$;

alter table public.user_roles enable row level security;

create policy user_roles_select_own on public.user_roles
  for select to authenticated using (user_id = auth.uid());

create policy user_roles_select_admin on public.user_roles
  for select to authenticated using (public.kmd_is_admin(auth.uid()));

-- ---------- profiles -----------------------------------------
create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  member_code text not null unique,
  referral_code text not null unique,
  username text not null unique,
  first_name text not null,
  last_name text not null,
  full_name text generated always as (first_name || ' ' || last_name) stored,
  mobile_number text,
  email text not null,
  sponsor_code text,
  direct_sponsor_id uuid references public.profiles(id),
  account_type text not null default 'member' check (account_type in ('member','retailer')),
  account_status text not null default 'pending' check (account_status in ('pending','active','inactive','suspended')),
  registration_date timestamptz not null default now(),
  activation_date timestamptz,
  profile_photo_url text,
  unilevel_points_balance numeric(14,2) not null default 0,
  loyalty_credits_balance numeric(14,2) not null default 0,
  shopping_wallet_balance numeric(14,2) not null default 0,
  total_lifetime_earnings numeric(14,2) not null default 0,
  is_test boolean not null default false,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index if not exists profiles_direct_sponsor_idx on public.profiles (direct_sponsor_id);
create index if not exists profiles_status_idx on public.profiles (account_status);
create unique index if not exists profiles_username_lower_idx on public.profiles (lower(username));
create unique index if not exists profiles_email_lower_idx on public.profiles (lower(email));

-- ---------- sponsor genealogy (closure table, levels 1-5) ------
create table if not exists public.sponsor_relationships (
  id uuid primary key default gen_random_uuid(),
  descendant_id uuid not null references public.profiles(id) on delete cascade,
  ancestor_id uuid not null references public.profiles(id) on delete cascade,
  level int not null check (level between 1 and 5),
  created_at timestamptz not null default now(),
  unique (descendant_id, ancestor_id),
  unique (descendant_id, level)
);

create index if not exists sponsor_rel_ancestor_idx on public.sponsor_relationships (ancestor_id, level);

create or replace function public.kmd_is_related(p_viewer uuid, p_member uuid)
returns boolean language sql stable security definer set search_path = public as $$
  select exists (
    select 1 from public.sponsor_relationships sr
    where sr.level <= 5
      and ((sr.ancestor_id = p_viewer and sr.descendant_id = p_member)
        or (sr.descendant_id = p_viewer and sr.ancestor_id = p_member))
  );
$$;

create or replace function public.kmd_is_in_downline(p_viewer uuid, p_member uuid)
returns boolean language sql stable security definer set search_path = public as $$
  select exists (
    select 1 from public.sponsor_relationships sr
    where sr.level <= 5 and sr.ancestor_id = p_viewer and sr.descendant_id = p_member
  );
$$;

-- ---------- RLS ----------------------------------------------
alter table public.profiles enable row level security;

create policy profiles_select_own on public.profiles
  for select to authenticated using (id = auth.uid());

create policy profiles_select_related on public.profiles
  for select to authenticated using (public.kmd_is_related(auth.uid(), id));

create policy profiles_select_admin on public.profiles
  for select to authenticated using (public.kmd_is_admin(auth.uid()));

create policy profiles_update_own on public.profiles
  for update to authenticated using (id = auth.uid()) with check (id = auth.uid());

create policy profiles_update_admin on public.profiles
  for update to authenticated using (public.kmd_is_admin(auth.uid())) with check (public.kmd_is_admin(auth.uid()));

alter table public.sponsor_relationships enable row level security;

create policy sponsor_rel_select_own on public.sponsor_relationships
  for select to authenticated using (descendant_id = auth.uid() or ancestor_id = auth.uid());

create policy sponsor_rel_select_admin on public.sponsor_relationships
  for select to authenticated using (public.kmd_is_admin(auth.uid()));

-- ---------- profile guards ------------------------------------
create or replace function public.kmd_protect_profile_columns()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  new.updated_at := now();
  -- Only end-user roles are restricted; server-side (security definer) writes pass through.
  if current_user in ('anon','authenticated') then
    if new.member_code is distinct from old.member_code
      or new.referral_code is distinct from old.referral_code
      or new.username is distinct from old.username
      or new.sponsor_code is distinct from old.sponsor_code
      or new.direct_sponsor_id is distinct from old.direct_sponsor_id
      or new.account_type is distinct from old.account_type
      or new.account_status is distinct from old.account_status
      or new.activation_date is distinct from old.activation_date
      or new.unilevel_points_balance is distinct from old.unilevel_points_balance
      or new.loyalty_credits_balance is distinct from old.loyalty_credits_balance
      or new.shopping_wallet_balance is distinct from old.shopping_wallet_balance
      or new.total_lifetime_earnings is distinct from old.total_lifetime_earnings
      or new.is_test is distinct from old.is_test
    then
      raise exception 'KMD_PROTECTED_FIELD: member code, sponsor, status and balances cannot be changed from the client';
    end if;
  end if;
  return new;
end $$;

create trigger kmd_profiles_protect
  before update on public.profiles
  for each row execute function public.kmd_protect_profile_columns();

-- ---------- registration -------------------------------------
create or replace function public.kmd_register_member(
  p_user_id uuid,
  p_email text,
  p_username text,
  p_first_name text,
  p_last_name text,
  p_mobile text,
  p_sponsor_code text default null,
  p_account_type text default 'member',
  p_is_test boolean default false
) returns jsonb
language plpgsql security definer set search_path = public as $$
declare
  v_seq bigint;
  v_pad text;
  v_code text;
  v_sponsor public.profiles%rowtype;
  v_sponsor_id uuid;
  v_sponsor_code text;
begin
  if p_username is null or length(trim(p_username)) < 3 then
    raise exception 'KMD_VALIDATION: username must be at least 3 characters';
  end if;
  if p_email is null or p_email !~ '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$' then
    raise exception 'KMD_VALIDATION: a valid email address is required';
  end if;
  if p_first_name is null or length(trim(p_first_name)) = 0 then
    raise exception 'KMD_VALIDATION: first name is required';
  end if;
  if exists (select 1 from public.profiles where lower(username) = lower(trim(p_username))) then
    raise exception 'KMD_DUPLICATE_USERNAME: that username is already taken';
  end if;
  if exists (select 1 from public.profiles where lower(email) = lower(trim(p_email))) then
    raise exception 'KMD_DUPLICATE_EMAIL: that email address is already registered';
  end if;

  if p_sponsor_code is not null and length(trim(p_sponsor_code)) > 0 then
    select * into v_sponsor from public.profiles p
      where upper(p.referral_code) = upper(trim(p_sponsor_code))
         or upper(p.member_code) = upper(trim(p_sponsor_code));
    if not found then
      raise exception 'KMD_INVALID_SPONSOR: sponsor ID % does not exist', p_sponsor_code;
    end if;
    v_sponsor_id := v_sponsor.id;
    v_sponsor_code := v_sponsor.member_code;
  end if;

  v_seq := nextval('public.kmd_member_code_seq');
  v_pad := lpad(v_seq::text, 16, '0');
  v_code := 'KMD-' || substr(v_pad,1,4) || '-' || substr(v_pad,5,4) || '-' || substr(v_pad,9,4) || '-' || substr(v_pad,13,4);

  insert into public.profiles (
    id, member_code, referral_code, username, first_name, last_name, mobile_number, email,
    sponsor_code, direct_sponsor_id, account_type, account_status, is_test
  ) values (
    p_user_id, v_code, v_code, trim(p_username), trim(p_first_name), trim(p_last_name),
    nullif(trim(coalesce(p_mobile,'')), ''), lower(trim(p_email)),
    v_sponsor_code, v_sponsor_id, coalesce(p_account_type,'member'), 'pending', coalesce(p_is_test,false)
  );

  if v_sponsor_id is not null then
    insert into public.sponsor_relationships (descendant_id, ancestor_id, level)
    values (p_user_id, v_sponsor_id, 1);

    insert into public.sponsor_relationships (descendant_id, ancestor_id, level)
    select p_user_id, sr.ancestor_id, sr.level + 1
    from public.sponsor_relationships sr
    where sr.descendant_id = v_sponsor_id and sr.level < 5;
  end if;

  insert into public.user_roles (user_id, role) values (p_user_id, coalesce(p_account_type,'member'))
  on conflict (user_id, role) do nothing;

  return jsonb_build_object(
    'memberCode', v_code,
    'referralCode', v_code,
    'referralLink', '/register?ref=' || v_code,
    'sponsorMemberCode', v_sponsor_code,
    'sponsorName', case when v_sponsor_id is null then null else v_sponsor.first_name || ' ' || v_sponsor.last_name end,
    'accountStatus', 'pending'
  );
end $$;

-- public lookups used by the registration / login screens
create or replace function public.kmd_username_available(p_username text)
returns boolean language sql stable security definer set search_path = public as $$
  select not exists (select 1 from public.profiles p where lower(p.username) = lower(trim(p_username)));
$$;

create or replace function public.kmd_sponsor_preview(p_code text)
returns jsonb language sql stable security definer set search_path = public as $$
  select coalesce(
    (select jsonb_build_object(
        'found', true,
        'memberCode', p.member_code,
        'displayName', p.first_name || ' ' || left(p.last_name, 1) || '.',
        'accountStatus', p.account_status)
     from public.profiles p
     where upper(p.referral_code) = upper(trim(p_code)) or upper(p.member_code) = upper(trim(p_code))
     limit 1),
    jsonb_build_object('found', false)
  );
$$;

create or replace function public.kmd_resolve_login(p_username text)
returns jsonb language sql stable security definer set search_path = public as $$
  select coalesce(
    (select jsonb_build_object('found', true, 'email', p.email, 'accountStatus', p.account_status)
     from public.profiles p where lower(p.username) = lower(trim(p_username)) limit 1),
    jsonb_build_object('found', false)
  );
$$;

-- ---------- grants -------------------------------------------
revoke all on function public.kmd_register_member(uuid,text,text,text,text,text,text,text,boolean) from public, anon, authenticated;
grant execute on function public.kmd_register_member(uuid,text,text,text,text,text,text,text,boolean) to service_role;
grant execute on function public.kmd_username_available(text) to anon, authenticated;
grant execute on function public.kmd_sponsor_preview(text) to anon, authenticated;
grant execute on function public.kmd_resolve_login(text) to anon, authenticated;
grant execute on function public.has_role(uuid,text) to authenticated;
grant execute on function public.kmd_is_admin(uuid) to authenticated;
grant execute on function public.kmd_is_related(uuid,uuid) to authenticated;
grant execute on function public.kmd_is_in_downline(uuid,uuid) to authenticated;
