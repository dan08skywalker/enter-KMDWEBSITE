-- Removes ONLY the temporary 'admin' role granted to testsponsor1 earlier in this
-- same turn to verify the adjustment path. Restores the prior authorization state;
-- no other role row, member or business record is touched.
delete from public.user_roles
 where role = 'admin'
   and user_id = (select id from public.profiles where username = 'testsponsor1');

select ur.role, count(*) as rows from public.user_roles ur group by ur.role order by ur.role;